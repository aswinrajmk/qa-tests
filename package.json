{
  "name": "qa-tests",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep \"@smoke|@regression\"",
    "test:ui": "playwright test --project=chromium",
    "test:api": "playwright test --project=api",
    "test:local": "TEST_ENV=local playwright test",
    "test:unit": "node --test \"tests/unit/**/*.test.ts\"",
    "check:tags": "node scripts/check-tags.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "verify": "npm run lint && npm run typecheck && npm run test:unit && npm run check:tags",
    "report": "playwright show-report",
    "prepare": "husky"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.1",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.65.1",
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "eslint-plugin-playwright": "2.12.2",
    "globals": "17.14.0",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2"
  }
}
